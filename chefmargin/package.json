{
  "name": "chefmargin-portable",
  "private": true,
  "version": "1.0.1",
  "description": "Offline food-cost and menu pricing application for Android and Windows",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.chefmargin.portable",
    "productName": "ChefMargin",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "web/**/*",
      "desktop/main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ChefMargin-Windows-Portable-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ChefMargin-Windows-Portable-${version}-${arch}.${ext}"
    }
  }
}
