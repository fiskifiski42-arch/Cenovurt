# Stripe
STRIPE_SECRET_KEY=sk_live_...

# Upstash Redis REST
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM=Ценовърт <alerts@your-domain.com>

# Separate auth secret (optional if CRON_SECRET is a strong secret)
AUTH_SECRET=put-a-long-random-unique-secret-here

# Vercel Cron security
CRON_SECRET=put-a-long-random-secret-here

# Optional – normally not needed on Vercel
APP_URL=https://cenovurt.vercel.app
MAX_CHECKS_PER_RUN=200

# Optional: backup price fetcher for stores returning HTTP 403/429
ZENROWS_API_KEY=
