# Stripe
STRIPE_SECRET_KEY=sk_live_...

# Upstash Redis REST
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM=Ценовърт <alerts@your-domain.com>

# Vercel Cron security
CRON_SECRET=put-a-long-random-secret-here

# Optional – normally not needed on Vercel
APP_URL=https://cenovurt.vercel.app
MAX_CHECKS_PER_RUN=200
